# Copy this file to .env and fill in real values. Never commit .env.

# Required: Anthropic API key for the Claude provider.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Claude model to use (defaults to a current Claude Sonnet model).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: orchestrator tuning.
ORCHESTRATOR_MAX_RETRIES_PER_TASK=2
ORCHESTRATOR_MAX_REPLANS=2
