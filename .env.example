# Copy this file to .env and fill in real values. Never commit .env.

# Required: Anthropic API key for the Claude provider.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Claude model to use (defaults to a current Claude Sonnet model).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: orchestrator tuning.
ORCHESTRATOR_MAX_RETRIES_PER_TASK=2
ORCHESTRATOR_MAX_REPLANS=2

# Optional: filesystem sandbox root for the file_read/file_write/list_files
# tools. All tool paths are resolved relative to this directory; no path
# (absolute, "..", or symlink) can ever escape it. Created automatically
# if it doesn't exist.
ORCHESTRATOR_SANDBOX_DIR=./sandbox

# Optional: default per-tool execution timeout in seconds (individual tools
# may declare a stricter timeout of their own).
ORCHESTRATOR_TOOL_TIMEOUT_SECONDS=30

# Optional: SQLite database file used to persist execution state and
# long-term memory (checkpointing/resume). Created automatically.
ORCHESTRATOR_STATE_DB=./orchestrator_state.db

# Optional: separate db file used only by --mock demo runs, so they never
# collide with a real run's persisted state.
ORCHESTRATOR_MOCK_STATE_DB=./orchestrator_state.mock.db

# Optional: DAG scheduler tuning.
# Max number of tasks the scheduler runs concurrently, regardless of how
# many are dependency-ready at once.
ORCHESTRATOR_MAX_CONCURRENT_TASKS=5
# Retry backoff: attempt N waits base * 2^(N-1) seconds, capped.
ORCHESTRATOR_RETRY_BACKOFF_BASE_SECONDS=0.5
ORCHESTRATOR_MAX_RETRY_BACKOFF_SECONDS=10
